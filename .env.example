# Скопируйте в .env и при необходимости измените значения
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# Backend
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Секрет для подписи токенов (демо-значение, в проде — из секрет-хранилища)
JWT_SECRET=change-me
# Показывать тестовые учётные записи на экране входа (для демо-стенда)
DEMO_MODE=true
# Интеграции: таймаут запроса, с, и число повторов при сбое
INTEGRATION_TIMEOUT_S=5
INTEGRATION_RETRIES=2

# Mocks (эмуляция задержки внешних сервисов, мс)
MOCKS_LATENCY_MS=0
