# Скопируйте в .env и при необходимости измените значения
POSTGRES_DB=credit
POSTGRES_USER=credit
POSTGRES_PASSWORD=credit

# Backend
APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Секрет для подписи токенов (демо-значение, в проде — из секрет-хранилища)
JWT_SECRET=change-me

# Mocks (эмуляция задержки внешних сервисов, мс)
MOCKS_LATENCY_MS=0
